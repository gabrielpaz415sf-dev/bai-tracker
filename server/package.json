{
  "name": "server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "//build": "Typecheck only. tsconfig uses moduleResolution:Bundler, which emits extensionless ESM imports that Node's own resolver rejects \u2014 so the emitted dist/ was never runnable. Nothing consumes it; tsx runs the source directly in both dev and start.",
    "build": "tsc -p tsconfig.json --noEmit",
    "start": "tsx src/index.ts",
    "refresh": "tsx src/cli/refresh.ts",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "brief": "tsx src/cli/brief.ts",
    "snapshot": "tsx src/cli/snapshot.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "nodemailer": "^9.0.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/nodemailer": "^8.0.1",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
